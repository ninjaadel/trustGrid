generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
id String @unique @default(uuid())
email String @unique
username String 
password String
}

model TestiMonials {
    id String @unique @default(uuid())
    authorName String 
    rating Ant
    content String
    authorAvatar String?
    isAproved Boolean @default(false)

}